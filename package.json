{
  "name": "oanquan-ai-lab",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "description": "Standalone Ô Ăn Quan AI research lab: production-reference search, MCTS, PVS, exact/SCC endgames, explicit repetition-policy experiments, self-play, opening analysis and balance research.",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": "./dist/src/index.js",
  "bin": { "oaq-ai": "dist/src/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "benchmark:research": "tsx src/benchmarks/research-vs-production.ts",
    "benchmark:server": "tsx src/benchmarks/research-vs-server-production.ts",
    "benchmark:openings:v2": "tsx src/benchmarks/opening-balance-v2.ts",
    "benchmark:openings:v3:deep": "tsx src/benchmarks/opening-balance-v3-deep.ts",
    "benchmark:openings:v3:selfplay": "tsx src/benchmarks/opening-balance-v3-selfplay.ts",
    "benchmark:openings:v4:exact": "tsx src/benchmarks/opening-balance-v4-exact.ts",
    "benchmark:openings:v4:graph": "tsx src/benchmarks/opening-balance-v4-graph.ts",
    "benchmark:openings:v5:policy-exact": "tsx src/benchmarks/opening-balance-v5-policy-exact.ts",
    "benchmark:openings:v5:selfplay-observer": "tsx src/benchmarks/opening-balance-v5-selfplay-observer.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=20" }
}
