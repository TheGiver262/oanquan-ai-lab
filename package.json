{
  "name": "oanquan-ai-lab",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Standalone Ô Ăn Quan AI research lab: production-reference search, MCTS, self-play, opening analysis and Pie Rule experiments.",
  "license": "MIT",
  "main": "dist/src/index.js",
