{
  "name": "oanquan-ai-lab",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "Standalone Ô Ăn Quan AI research lab: production-reference search, MCTS, independent PVS search, exact and SCC-aware endgame analysis, self-play, opening analysis and balance experiments.",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": "./dist/src/index.js",
  "bin": {
    "oaq-ai": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "benchmark:research": "tsx src/benchmarks/research-vs-production.ts",
    "benchmark:server": "tsx src/benchmarks/research-vs-server-production.ts",
    "benchmark:balance": "tsx src/benchmarks/balance-mode-v3a-selfplay.ts",
    "benchmark:b3:resource": "tsx src/benchmarks/b3-resource-aware-selfplay.ts",
    "benchmark:b3:double100k": "tsx src/benchmarks/double-forced-deviation-selfplay.ts",
    "benchmark:r1d": "tsx src/benchmarks/r1d-production-semantics-v3a-vs-trang-nguyen.ts",
    "benchmark:challenger": "tsx src/benchmarks/v3a-challenger-tournament.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
